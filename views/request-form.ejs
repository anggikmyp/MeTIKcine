<%- include('partials/header', { title: med.name }) %>
<a href="/<%= kind %>" class="text-sm text-teal-700 underline">Kembali ke daftar obat</a>
<div class="mt-4 grid gap-6 md:grid-cols-2">
  <div class="card">
    <div class="mb-4 grid h-48 place-items-center overflow-hidden rounded-lg bg-teal-50 text-6xl">
      <% if (med.image_url) { %><img src="<%= med.image_url %>" alt="<%= med.name %>" class="h-48 w-full object-cover"><% } else { %>💊<% } %>
    </div>
    <h1 class="text-xl font-bold"><%= med.name %></h1>
    <p class="text-sm text-slate-500"><%= med.category %>, stok <%= med.stock %></p>
    <% if (med.description) { %><p class="mt-3 text-sm"><%= med.description %></p><% } %>
    <% if (med.usage_info) { %><h2 class="mt-4 text-sm font-semibold">Cara pakai</h2><p class="text-sm text-slate-700"><%= med.usage_info %></p><% } %>
  </div>
  <form method="post" action="/<%= kind %>/<%= med.id %>" class="card space-y-4">
    <h2 class="font-semibold"><%= k.title %></h2>
    <% if (errors.length) { %>
      <ul class="list-disc rounded-lg border border-rose-200 bg-rose-50 py-3 pl-8 pr-4 text-sm text-rose-800"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
    <% } %>
    <% if (med.stock < 1) { %><p class="rounded-lg bg-amber-50 p-3 text-sm text-amber-800">Stok sedang habis, pengajuan belum bisa dibuat.</p><% } %>
    <div><label class="label" for="qty">Jumlah</label><input id="qty" type="number" name="qty" min="1" max="<%= med.stock %>" value="<%= form.qty || 1 %>" class="input" required></div>
    <div><label class="label" for="reason">Alasan</label><textarea id="reason" name="reason" rows="3" maxlength="255" class="input" required><%= form.reason || '' %></textarea></div>
    <div><label class="label" for="pickup_date">Tanggal ambil</label><input id="pickup_date" type="date" name="pickup_date" min="<%= today() %>" value="<%= form.pickup_date || today() %>" class="input" required></div>
    <% if (k.type === 'pinjam') { %>
      <div><label class="label" for="due_date">Tanggal kembali (maksimal <%= maxDays %> hari)</label><input id="due_date" type="date" name="due_date" min="<%= today() %>" value="<%= form.due_date || '' %>" class="input" required></div>
    <% } else { %>
      <p class="text-xs text-slate-500">Kuota pengambilan: <%= quota %> item per hari.</p>
    <% } %>
    <button class="btn-primary w-full" <%= med.stock < 1 ? 'disabled' : '' %>><%= k.button %></button>
  </form>
</div>
<%- include('partials/footer') %>
