<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= locals.title ? title + ' - ' : '' %>MatikCine</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'] } } } }</script>
<style type="text/tailwindcss">
  @layer components {
    .btn-primary { @apply inline-flex items-center justify-center rounded-lg bg-teal-700 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700; }
    .btn-ghost { @apply inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100; }
    .btn-danger { @apply inline-flex items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700; }
    .card { @apply rounded-xl border border-slate-200 bg-white p-5; }
    .input { @apply w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-teal-600 focus:outline-none focus:ring-1 focus:ring-teal-600; }
    .label { @apply mb-1 block text-sm font-medium text-slate-700; }
    .th { @apply px-3 py-2 text-left text-sm font-semibold text-slate-600; }
    .td { @apply px-3 py-2.5 text-sm; }
  }
</style>
</head>
<body class="min-h-screen bg-stone-50 font-sans text-slate-800">
<% if (user) {
  const nav = user.role === 'admin'
    ? [['/admin','Beranda'],['/admin/obat','Kelola Obat'],['/admin/status/pengambilan','Pengambilan'],['/admin/status/peminjaman','Peminjaman'],['/admin/status/pengembalian','Pengembalian'],['/admin/status/donasi','Donasi'],['/admin/pengguna','Pengguna'],['/profil','Profil']]
    : [['/','Beranda'],['/p3k','P3K'],['/pinjam','Peminjaman'],['/pengembalian','Pengembalian'],['/donasi','Donasi'],['/riwayat','Riwayat'],['/profil','Profil']];
  const active = (h) => (h === '/' || h === '/admin') ? path === h : path === h || path.startsWith(h + '/');
%>
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
    <a href="<%= user.role === 'admin' ? '/admin' : '/' %>" class="flex items-center gap-2 text-lg font-bold text-teal-800">
      <span class="grid h-7 w-7 place-items-center rounded bg-teal-700 text-white">+</span>MatikCine
    </a>
    <nav class="flex flex-1 gap-1 overflow-x-auto text-sm">
      <% nav.forEach(([href, label]) => { %>
        <a href="<%= href %>" class="whitespace-nowrap rounded-md px-3 py-1.5 <%= active(href) ? 'bg-teal-50 font-semibold text-teal-800' : 'text-slate-600 hover:bg-slate-100' %>"><%= label %></a>
      <% }) %>
    </nav>
    <form method="post" action="/logout"><button class="btn-ghost">Keluar</button></form>
  </div>
</header>
<% } %>
<main class="mx-auto max-w-6xl px-4 py-6">
<% if (flash) { %>
  <div role="status" class="mb-4 rounded-lg border px-4 py-3 text-sm <%= flash.type === 'success' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-800' %>"><%= flash.text %></div>
<% } %>
