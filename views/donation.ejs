<%- include('partials/header', { title: 'Donasi' }) %>
<h1 class="mb-1 text-2xl font-bold">Donasi obat</h1>
<p class="mb-6 text-sm text-slate-600">Punya obat layak pakai? Admin akan memeriksa kelayakannya sebelum masuk ke stok.</p>
<div class="grid gap-6 md:grid-cols-2">
  <form method="post" action="/donasi" class="card space-y-4 self-start">
    <h2 class="font-semibold">Kirim donasi</h2>
    <% if (errors.length) { %>
      <ul class="list-disc rounded-lg border border-rose-200 bg-rose-50 py-3 pl-8 pr-4 text-sm text-rose-800"><% errors.forEach((e) => { %><li><%= e %></li><% }) %></ul>
    <% } %>
    <div><label class="label" for="medicine_name">Nama obat</label><input id="medicine_name" name="medicine_name" value="<%= form.medicine_name || '' %>" class="input" required></div>
    <div class="grid grid-cols-2 gap-3">
      <div><label class="label" for="qty">Jumlah</label><input id="qty" type="number" min="1" name="qty" value="<%= form.qty || 1 %>" class="input" required></div>
      <div><label class="label" for="condition_type">Kondisi</label>
        <select id="condition_type" name="condition_type" class="input"><option value="baru">Baru</option><option value="sisa" <%= form.condition_type === 'sisa' ? 'selected' : '' %>>Sisa pakai</option></select></div>
    </div>
    <div><label class="label" for="expiry_date">Tanggal kadaluwarsa</label><input id="expiry_date" type="date" name="expiry_date" min="<%= today() %>" value="<%= form.expiry_date || '' %>" class="input" required></div>
    <div><label class="label" for="condition_desc">Penjelasan kondisi</label><textarea id="condition_desc" name="condition_desc" rows="3" maxlength="255" class="input" required><%= form.condition_desc || '' %></textarea></div>
    <button class="btn-primary w-full">Kirim donasi</button>
  </form>
  <div>
    <h2 class="mb-3 font-semibold">Donasi saya</h2>
    <% if (!rows.length) { %><p class="text-sm text-slate-500">Belum ada donasi.</p><% } %>
    <div class="grid gap-3">
      <% rows.forEach((d) => { %>
        <div class="card">
          <div class="flex items-start justify-between gap-2">
            <div><div class="font-semibold"><%= d.medicine_name %> <span class="font-normal text-slate-500">x<%= d.qty %></span></div>
            <div class="text-sm text-slate-600">Kadaluwarsa <%= d.expiry_date %></div></div>
            <span class="<%= statusClass(d.status) %>"><%= statusLabel(d.status, 'donasi') %></span>
          </div>
          <% if (d.admin_note) { %><p class="mt-2 text-sm text-slate-600">Catatan admin: <%= d.admin_note %></p><% } %>
          <% if (d.status === 'menunggu') { %><form method="post" action="/donasi/<%= d.id %>/batal" class="mt-3"><button class="btn-ghost">Batalkan</button></form><% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
