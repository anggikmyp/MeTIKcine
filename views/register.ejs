<%- include('partials/header', { title: 'Daftar' }) %>
<div class="mx-auto mt-8 max-w-md">
  <h1 class="mb-4 text-2xl font-bold text-teal-800">Buat akun mahasiswa</h1>
  <% if (errors.length) { %>
    <ul class="mb-4 list-disc rounded-lg border border-rose-200 bg-rose-50 py-3 pl-8 pr-4 text-sm text-rose-800">
      <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>
  <form method="post" action="/register" class="card space-y-4">
    <div><label class="label" for="name">Nama lengkap</label><input id="name" name="name" class="input" value="<%= form.name || '' %>" required></div>
    <div><label class="label" for="email">Email PNJ</label><input id="email" type="email" name="email" class="input" placeholder="nama@mhsw.pnj.ac.id" value="<%= form.email || '' %>" required></div>
    <div><label class="label" for="nim">NIM</label><input id="nim" name="nim" inputmode="numeric" class="input" value="<%= form.nim || '' %>" required></div>
    <div><label class="label" for="phone">Nomor telepon</label><input id="phone" name="phone" class="input" value="<%= form.phone || '' %>"></div>
    <div><label class="label" for="password">Kata sandi (minimal 8 karakter)</label><input id="password" type="password" name="password" minlength="8" class="input" required></div>
    <div><label class="label" for="password2">Ulangi kata sandi</label><input id="password2" type="password" name="password2" class="input" required></div>
    <button class="btn-primary w-full">Daftar</button>
    <p class="text-center text-sm text-slate-600">Sudah punya akun? <a class="font-medium text-teal-700 underline" href="/login">Masuk</a></p>
  </form>
</div>
<%- include('partials/footer') %>
