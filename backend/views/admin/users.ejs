<%- include('../partials/header', { title: 'Data pengguna' }) %>
<h1 class="mb-4 text-2xl font-bold">Data pengguna</h1>
<form method="get" class="mb-4 flex gap-2"><input name="q" value="<%= q %>" placeholder="Cari nama, NIM, atau email" class="input max-w-xs"><button class="btn-ghost">Cari</button></form>
<div class="card overflow-x-auto !p-0">
  <table class="w-full">
    <thead class="border-b border-slate-200"><tr><th class="th">Nama</th><th class="th">NIM</th><th class="th">Kelas</th><th class="th">Email</th><th class="th">Telepon</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% if (!rows.length) { %><tr><td colspan="5" class="td text-slate-500">Belum ada mahasiswa terdaftar.</td></tr><% } %>
      <% rows.forEach((u) => { %>
        <tr><td class="td font-medium"><%= u.name %></td><td class="td"><%= u.nim %></td><td class="td"><%= u.class_name || '-' %></td><td class="td"><%= u.email %></td><td class="td"><%= u.phone || '-' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
