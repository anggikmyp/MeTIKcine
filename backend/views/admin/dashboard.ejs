<%- include('../partials/header', { title: 'Dashboard admin' }) %>
<h1 class="mb-6 text-2xl font-bold">Dashboard admin</h1>
<div class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
  <a href="/admin/status/pengambilan?status=menunggu" class="card hover:border-teal-600"><div class="text-3xl font-bold text-amber-600"><%= s.menunggu %></div><div class="text-sm text-slate-600">Pengajuan menunggu persetujuan</div></a>
  <a href="/admin/status/pengembalian?status=diserahkan" class="card hover:border-teal-600"><div class="text-3xl font-bold text-teal-700"><%= s.dipinjam %></div><div class="text-sm text-slate-600">Barang sedang dipinjam</div></a>
  <a href="/admin/status/donasi?status=menunggu" class="card hover:border-teal-600"><div class="text-3xl font-bold text-teal-700"><%= s.donasi %></div><div class="text-sm text-slate-600">Donasi menunggu verifikasi</div></a>
  <a href="/admin/obat" class="card hover:border-teal-600"><div class="text-3xl font-bold text-slate-700"><%= s.obat %></div><div class="text-sm text-slate-600">Jenis obat terdaftar</div></a>
</div>
<% if (low.length) { %>
  <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    <div class="font-semibold">Stok menipis (<%= LOW_STOCK %> atau kurang)</div>
    <div class="mt-1"><%= low.map((m) => m.name + ' (' + m.stock + ')').join(', ') %></div>
  </div>
<% } %>
<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <h2 class="mb-3 font-semibold">Aktivitas terbaru</h2>
    <div class="card overflow-x-auto !p-0">
      <table class="w-full">
        <thead class="border-b border-slate-200"><tr><th class="th">Mahasiswa</th><th class="th">Obat</th><th class="th">Status</th><th></th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% if (!latest.length) { %><tr><td colspan="4" class="td text-slate-500">Belum ada aktivitas.</td></tr><% } %>
          <% latest.forEach((t) => { %>
            <tr>
              <td class="td"><%= t.user_name %><div class="text-xs text-slate-500"><%= t.nim %></div></td>
              <td class="td"><%= t.medicine_name %> x<%= t.qty %></td>
              <td class="td"><span class="<%= statusClass(t.status) %>"><%= statusLabel(t.status, t.type) %></span></td>
              <td class="td"><a class="text-teal-700 underline" href="/admin/transaksi/<%= t.id %>">Detail</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div>
    <h2 class="mb-3 font-semibold">Donasi terbaru</h2>
    <div class="card divide-y divide-slate-100 !p-0">
      <% if (!donations.length) { %><div class="td text-slate-500">Belum ada donasi.</div><% } %>
      <% donations.forEach((d) => { %>
        <a href="/admin/donasi/<%= d.id %>" class="flex items-center justify-between gap-2 px-4 py-3 text-sm hover:bg-slate-50">
          <div><div class="font-medium"><%= d.medicine_name %> x<%= d.qty %></div><div class="text-xs text-slate-500"><%= d.user_name %></div></div>
          <span class="<%= statusClass(d.status) %>"><%= statusLabel(d.status, 'donasi') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
