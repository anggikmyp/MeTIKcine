<%- include('partials/header', { title: 'Riwayat' }) %>
<h1 class="mb-4 text-2xl font-bold">Riwayat</h1>
<div class="mb-5 flex flex-wrap gap-2 text-sm">
  <% [['semua','Semua'],['ambil','Pengambilan'],['pinjam','Peminjaman'],['kembali','Pengembalian'],['donasi','Donasi']].forEach(([v, l]) => { %>
    <a href="/riwayat?jenis=<%= v %>" class="rounded-full px-4 py-1.5 <%= jenis === v ? 'bg-teal-700 font-semibold text-white' : 'border border-slate-300 bg-white text-slate-700 hover:bg-slate-100' %>"><%= l %></a>
  <% }) %>
</div>
<% if (!rows.length) { %><p class="text-slate-500">Belum ada data untuk kategori ini.</p><% } %>
<div class="grid gap-3">
  <% rows.forEach((r) => { %>
    <div class="card flex flex-wrap items-center justify-between gap-3">
      <div>
        <div class="font-semibold"><%= r.name %> <span class="font-normal text-slate-500">x<%= r.qty %></span></div>
        <div class="text-sm text-slate-600"><%= r.label %>, diajukan <%= r.date.slice(0, 10) %>. <%= r.detail %></div>
        <% if (r.note) { %><div class="text-sm text-slate-600">Catatan admin: <%= r.note %></div><% } %>
      </div>
      <div class="flex items-center gap-2">
        <span class="<%= statusClass(r.status) %>"><%= statusLabel(r.status, r.jenis) %></span>
        <% if (r.cancelUrl) { %><form method="post" action="<%= r.cancelUrl %>"><button class="btn-ghost">Batalkan</button></form><% } %>
      </div>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
