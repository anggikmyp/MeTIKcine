<%- include('partials/header', { title: 'Masuk' }) %>
<div class="mx-auto mt-8 max-w-md">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-teal-800">MatikCine</h1>
    <p class="text-sm text-slate-600">Pinjam, ambil, dan donasi obat P3K untuk mahasiswa TIK PNJ.</p>
  </div>
  <form method="post" action="/login" class="card space-y-4">
    <div><label class="label" for="identifier">Email PNJ atau NIM</label><input id="identifier" name="identifier" class="input" required autofocus></div>
    <div><label class="label" for="password">Kata sandi</label><input id="password" type="password" name="password" class="input" required></div>
    <button class="btn-primary w-full">Masuk</button>
    <p class="text-center text-sm text-slate-600">Belum punya akun? <a class="font-medium text-teal-700 underline" href="/register">Daftar</a></p>
  </form>
</div>
<%- include('partials/footer') %>
